+# E1 PLANT -- applied by ``tools/e1_plant.patch``, never committed to ``src/``.
+#
+# The band is the one the review that invented E1 chose: a 3-10% move on the *next* session is a
+# credible crash-eve signal, which is what makes the escape worth closing rather than contrived.
+_E1_BAND = (0.03, 0.10)
+
+
+def _next_session_return(returns: pd.Series) -> pd.Series:
+    """``r[t+1]`` down the series, spelled with no ``shift``, no slice and no ``center``.
+
+    ``drop`` / ``set_axis`` / ``reindex``, with the axis built by ``Index.delete`` rather than
+    ``index[:-1]``. That last detail is not cosmetic: the first version of this plant used the
+    negative slice, the Phase 1 AST scan caught it, and the escape would have been understated.
+    Removing the slice made it scan-silent -- and only then did the whole Phase 1 point-in-time
+    suite pass a genuine forward peek.
+    """
+    size = len(returns)
+    ahead = returns.drop(returns.index[0])
+    return ahead.set_axis(returns.index.delete(size - 1)).reindex(returns.index)
